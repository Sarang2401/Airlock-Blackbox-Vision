  "private": true,
  "description": "EscrowHealth: private bill review, privacy receipts, and hybrid-inference observability",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
